# Local MongoDB is private to this computer. Use the same MongoDB Atlas URI on both computers to share accounts and bookings.
MONGODB_URI=mongodb://127.0.0.1:27017/cinebook
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
VITE_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CINEBOOK_ADMIN_EMAIL=
CINEBOOK_ADMIN_PASSWORD=

# Razorpay Hosted Checkout (preferred when configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PayU Hosted Checkout (test is the safe default)
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=test
# Use your public HTTPS backend URL in deployment; local development defaults to localhost:4000
# PAYU_CALLBACK_URL=https://your-domain.example/api/payments/payu/callback
# FRONTEND_URL=https://your-domain.example
